px}\n\n  /* ---------- 说明 / 步骤 ---------- */\n  .guide{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}\n  .guide .ticket{padding:24px}\n  .guide .step-no{font-size:12px;letter-spacing:.2em;color:var(--accent);font-weight:700;margin-bottom:10px}\n  .guide h3{margin:0 0 10px;font-size:18px;font-weight:800}\n  .guide p{margin:0;font-size:14px;color:var(--gray-1)}\n\n  /* ---------- 客户端 ---------- */\n  .clients{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}\n  .clients .ticket{padding:22px 24px}\n  .clients h3{margin:0 0 8px;font-size:17px;font-weight:800}\n  .clients p{margin:0;font-size:14px;color:var(--gray-1)}\n  .clients .status{display:inline-block;margin-top:12px;font-size:12px;color:var(--gray-2);border:1px dashed var(--gray-3);padding:2px 8px;border-radius:2px}\n\n  /* ---------- FAQ 对话气泡 ---------- */\n  .faq{display:flex;flex-direction:column;gap:22px}\n  .qa{display:flex;gap:16px;align-items:flex-start}\n  .qa .who{flex:0 0 44px;width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;border:1px solid var(--gray-3);background:var(--white);color:var(--gray-1)}\n  .qa.q .who{background:var(--ink);color:var(--white);border-color:var(--ink)}\n  .bubble{background:var(--white);border:1px dashed var(--gray-2);border-radius:2px 14px 14px 14px;padding:16px 20px;max-width:760px}\n  .qa.a{flex-direction:row}\n  .qa.a .bubble{border-radius:14px 2px 14px 14px;border-style:solid;border-color:var(--gray-3);background:var(--white)}\n  .bubble h3{margin:0 0 6px;font-size:15px;font-weight:800}\n  .bubble p{margin:0;font-size:14px;color:var(--gray-1)}\n  .bubble p + p{margin-top:8px}\n\n  /* ---------- 结尾 ---------- */\n  .end{border-top:1px solid var(--gray-3);padding:36px 0 64px;font-size:13px;color:var(--gray-2);display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}\n  .end a{border-bottom:1px dotted var(--gray-3)}\n\n  @media (max-width:820px){\n    .hero-lead{grid-template-columns:1fr;gap:28px}\n    .plans{grid-template-columns:1fr}\n    .guide{grid-template-columns:1fr}\n    .clients{grid-template-columns:1fr}\n    .ticket.featured{box-shadow:6px 6px 0 var(--ink)}\n    section{padding:48px 0}\n  }\n  @media (max-width:480px){\n    .wrap{padding:0 18px}\n    .hero{padding:40px 0 32px}\n    .qa .who{flex-basis:34px;width:34px;height:34px;font-size:12px}\n    .bubble{padding:14px 16px}\n  }\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-top\">\n        <div class=\"eyebrow\">Walkunderground · 说明书</div>\n        <nav class=\"jump\" aria-label=\"页内跳转\">\n          <a href=\"#plans\">套餐</a>\n          <a href=\"#howto\">怎么用</a>\n          <a href=\"#clients\">客户端</a>\n          <a href=\"#faq\">问答</a>\n        </nav>\n      </div>\n\n      <h1 class=\"brand\">walk<span class=\"cap\">under</span>ground</h1>\n\n      <div class=\"hero-lead\">\n        <p>这个页面只做三件事：把 <strong>套餐列清楚</strong>、把 <strong>上手步骤写明白</strong>、把 <strong>常见疑问答完</strong>。没有滚动横幅，也没有夸大的形容词，你按需要对比，按步骤操作即可。</p>\n        <div class=\"hero-notes\">\n          <ul>\n            <li>价格与容量按档位并列，方便横向看</li>\n            <li>步骤按顺序做，不需要跳读</li>\n            <li>客户端下载地址未确认，页面不提供外链</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">01</span>\n        <h2>套餐对照</h2>\n      </div>\n      <p class=\"sec-sub\">左边是入门与团队两类档位，右边是带推荐标记的旗舰档。所有价格与容量按同一口径列出。</p>\n\n      <div class=\"plans\">\n\n        <div class=\"plans-col\">\n          <div class=\"col-label\">基础 · 团队</div>\n\n          <article class=\"ticket plan\">\n            <h3>基础版</h3>\n            <p class=\"price\">¥15<span> / 月</span></p>\n            <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n            <ul>\n              <li>每月 100GB 流量</li>\n              <li>支持 3 台设备同时在线</li>\n              <li>解锁基础流媒体</li>\n              <li>普通线路节点池</li>\n            </ul>\n          </article>\n\n          <article class=\"ticket plan\">\n            <h3>团队版</h3>\n            <p class=\"price\">¥85<span> / 月</span></p>\n            <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n            <ul>\n              <li>每月 1000GB 流量</li>\n              <li>支持 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>专属客户经理服务</li>\n            </ul>\n          </article>\n        </div>\n\n        <div class=\"plans-col\">\n          <div class=\"col-label\">推荐档位</div>\n\n          <article class=\"ticket plan featured\">\n            <h3>旗舰版 <span class=\"badge\">推荐</span></h3>\n            <p class=\"price\">¥35<span> / 月</span></p>\n            <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n            <ul>\n              <li>每月 300GB 流量</li>\n              <li>支持 5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n          </article>\n\n          <p class=\"plan-note\">选档建议：一个人日常用，旗舰版的容量与设备数比较居中；多人共用或需要定制路由，再考虑团队版。以上信息以实际购买页面为准。</p>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">02</span>\n        <h2>怎么开始用</h2>\n      </div>\n      <p class=\"sec-sub\">按顺序做完这三步，再看客户端部分。中途卡住可以直接跳到问答区。</p>\n\n      <div class=\"guide\">\n        <article class=\"ticket\">\n          <div class=\"step-no\">STEP 01</div>\n          <h3>先定档位</h3>\n          <p>对照上面的套餐表，看两项就够：每月流量和同时在线设备数。其余条目作为加分项参考，不要为了用不上的权益多花钱。</p>\n        </article>\n\n        <article class=\"ticket\">\n          <div class=\"step-no\">STEP 02</div>\n          <h3>再准备客户端</h3>\n          <p>在你要用的设备上装好客户端，确认系统版本可用。客户端具体来源以官方渠道为准，本页不放下载链接，避免误装来源不明的安装包。</p>\n        </article>\n\n        <article class=\"ticket\">\n          <div class=\"step-no\">STEP 03</div>\n          <h3>最后核对设置</h3>\n          <p>打开客户端后核对账号、设备数量上限与线路选择是否与所购档位一致。数量超限通常表现为无法新增连接，先停用不用的设备再试。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">03</span>\n        <h2>客户端与设备</h2>\n      </div>\n      <p class=\"sec-sub\">不同系统需要的客户端不同。下面只写准备事项，不列举未经核实的下载地址。</p>\n\n      <div class=\"clients\">\n        <article class=\"ticket\">\n          <h3>桌面端</h3>\n          <p>在电脑上使用前，先确认操作系统版本与客户端要求相符，安装时留意权限提示是否合理。安装完成后先用基础档试用连接，再按需升级。</p>\n          <span class=\"status\">下载地址：以官方渠道为准</span>\n        </article>\n\n        <article class=\"ticket\">\n          <h3>移动端</h3>\n          <p>手机或平板上使用时，注意客户端与系统版本匹配，并在设置里允许必要的网络权限。移动端同样计入同时在线设备数，别忽略这一点。</p>\n          <span class=\"status\">下载地址：以官方渠道为准</span>\n        </article>\n\n        <article class=\"ticket\">\n          <h3>设备数量管理</h3>\n          <p>基础版 3 台、旗舰版 5 台、团队版 20 台。把常用设备固定下来，临时设备用完退出登录，避免占满名额。</p>\n          <span class=\"status\">按所购档位执行</span>\n        </article>\n\n        <article class=\"ticket\">\n          <h3>线路选择</h3>\n          <p>旗舰版与团队版涉及的专线、高带宽节点，需要在客户端里手动选择对应线路才会生效。默认线路不一定是你想用的那一条。</p>\n          <span class=\"status\">以客户端内可见线路为准</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">04</span>\n        <h2>常见问题</h2>\n      </div>\n      <p class=\"sec-sub\">以下问答按提问顺序排列，答案尽量给出可执行的动作，而不是笼统结论。</p>\n\n      <div class=\"faq\">\n\n        <div class=\"qa q\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>三个档位到底怎么选？</h3>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>先看每月流量：100GB、300GB、1000GB 对应基础版、旗舰版、团队版。再看同时在线设备数 3、5、20。两个数字都能覆盖，就选最接近的那档，不必往上加。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>按年付和按月付差多少？</h3>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>基础版按年 ¥150、旗舰版按年 ¥350、团队版按年 ¥850。以月为单位折算，年付低于按月的合计数。是否年付取决于你打算用多久，短期试用建议先按月。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>设备数超了会怎样？</h3>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>通常表现为新设备无法建立连接，而已在线设备不受影响。处理方式：在旧设备上退出登录，或减少同时连接数量，再重新尝试。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>客户端从哪里获取？</h3>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>本页没有列出下载地址，因为来源未经核实。请通过官方渠道获取安装包，安装前核对应用名称与发布方，避免安装来路不明的版本。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>流媒体解锁和专线是默认开着的吗？</h3>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>不是。流媒体解锁和专线节点需要在客户端内选择对应线路，默认线路未必支持这些特性。选好后如果没生效，先检查线路是否切换成功。</p>\n          </div>\n        </div>\n\n        <div class=\"qa q\">\n          <div class=\"who\">问</div>\n          <div class=\"bubble\">\n            <h3>团队版适合什么情况？</h3>\n          </div>\n        </div>\n        <div class=\"qa a\">\n          <div class=\"who\">答</div>\n          <div class=\"bubble\">\n            <p>适合多设备集中管理、需要定制路由的场景。如果只是个人在两三台设备上用，基础版或旗舰版就够，不必直接跳到团队版。</p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <footer class=\"end\">\n    <div class=\"wrap\">\n      <span>walkunderground · 套餐、步骤与问答说明</span>\n      <span><a href=\"#plans\">回到套餐</a></span>\n    </div>\n  </footer>\n\n</main>",
